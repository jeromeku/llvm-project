--- |
  ; ModuleID = 'simple.ll'
  source_filename = "simple.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64"
  
  ; Function Attrs: nofree norecurse nosync nounwind memory(argmem: read) uwtable
  define dso_local i32 @foo(ptr noundef readonly captures(none) %0, i32 noundef %1) local_unnamed_addr #0 {
    %3 = icmp sgt i32 %1, 0
    br i1 %3, label %4, label %30
  
  4:                                                ; preds = %2
    %5 = zext nneg i32 %1 to i64
    %6 = icmp ult i32 %1, 8
    br i1 %6, label %27, label %7
  
  7:                                                ; preds = %4
    %8 = and i64 %5, 2147483640
    %9 = lshr i64 %5, 3
    %10 = trunc i64 %9 to i28
    %11 = zext i28 %10 to i64
    %12 = shl nuw nsw i64 %11, 5
    br label %13
  
  13:                                               ; preds = %13, %7
    %lsr.iv = phi i64 [ %lsr.iv.next, %13 ], [ 0, %7 ]
    %14 = phi <4 x i32> [ zeroinitializer, %7 ], [ %20, %13 ]
    %15 = phi <4 x i32> [ zeroinitializer, %7 ], [ %21, %13 ]
    %sunkaddr = getelementptr i8, ptr %0, i64 %lsr.iv
    %16 = load <4 x i32>, ptr %sunkaddr, align 4, !tbaa !5
    %sunkaddr6 = getelementptr i8, ptr %0, i64 %lsr.iv
    %sunkaddr7 = getelementptr i8, ptr %sunkaddr6, i64 16
    %17 = load <4 x i32>, ptr %sunkaddr7, align 4, !tbaa !5
    %18 = mul nsw <4 x i32> %16, splat (i32 3)
    %19 = mul nsw <4 x i32> %17, splat (i32 3)
    %20 = add <4 x i32> %18, %14
    %21 = add <4 x i32> %19, %15
    %lsr.iv.next = add nuw nsw i64 %lsr.iv, 32
    %22 = icmp eq i64 %12, %lsr.iv.next
    br i1 %22, label %23, label %13, !llvm.loop !9
  
  23:                                               ; preds = %13
    %24 = add <4 x i32> %21, %20
    %rdx.shuf = shufflevector <4 x i32> %24, <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 poison, i32 poison>
    %bin.rdx = add <4 x i32> %24, %rdx.shuf
    %rdx.shuf4 = shufflevector <4 x i32> %bin.rdx, <4 x i32> poison, <4 x i32> <i32 1, i32 poison, i32 poison, i32 poison>
    %bin.rdx5 = add <4 x i32> %bin.rdx, %rdx.shuf4
    %25 = extractelement <4 x i32> %bin.rdx5, i32 0
    %26 = icmp eq i64 %8, %5
    br i1 %26, label %30, label %27
  
  27:                                               ; preds = %23, %4
    %28 = phi i64 [ 0, %4 ], [ %8, %23 ]
    %29 = phi i32 [ 0, %4 ], [ %25, %23 ]
    br label %32
  
  30:                                               ; preds = %32, %23, %2
    %31 = phi i32 [ 0, %2 ], [ %25, %23 ], [ %38, %32 ]
    ret i32 %31
  
  32:                                               ; preds = %32, %27
    %33 = phi i64 [ %39, %32 ], [ %28, %27 ]
    %34 = phi i32 [ %38, %32 ], [ %29, %27 ]
    %35 = shl i64 %33, 2
    %scevgep = getelementptr i8, ptr %0, i64 %35
    %36 = load i32, ptr %scevgep, align 4, !tbaa !5
    %37 = mul nsw i32 %36, 3
    %38 = add nsw i32 %37, %34
    %39 = add nuw nsw i64 %33, 1
    %40 = icmp eq i64 %5, %39
    br i1 %40, label %30, label %32, !llvm.loop !13
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #1
  
  attributes #0 = { nofree norecurse nosync nounwind memory(argmem: read) uwtable "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87" "tune-cpu"="generic" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
  
  !llvm.module.flags = !{!0, !1, !2, !3}
  !llvm.ident = !{!4}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{!"Ubuntu clang version 22.0.0 (++20251007042053+9cbcc87f5b22-1~exp1~20251007042222.2713)"}
  !5 = !{!6, !6, i64 0}
  !6 = !{!"int", !7, i64 0}
  !7 = !{!"omnipotent char", !8, i64 0}
  !8 = !{!"Simple C/C++ TBAA"}
  !9 = distinct !{!9, !10, !11, !12}
  !10 = !{!"llvm.loop.mustprogress"}
  !11 = !{!"llvm.loop.isvectorized", i32 1}
  !12 = !{!"llvm.loop.unroll.runtime.disable"}
  !13 = distinct !{!13, !10, !12, !11}
...
---
name:            foo
alignment:       16
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   true
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$rdi', virtual-reg: '' }
  - { reg: '$esi', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0 (%ir-block.2):
    successors: %bb.2(0x50000000), %bb.1(0x30000000)
    liveins: $esi, $rdi
  
    TEST32rr renamable $esi, renamable $esi, implicit-def $eflags
    JCC_1 %bb.1, 14, implicit $eflags
  
  bb.2 (%ir-block.4):
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
    liveins: $esi, $rdi
  
    renamable $ecx = MOV32rr renamable $esi, implicit-def $rcx
    CMP32ri killed renamable $esi, 8, implicit-def $eflags
    JCC_1 %bb.4, 3, implicit killed $eflags
  
  bb.3:
    successors: %bb.7(0x80000000)
    liveins: $rcx, $rdi
  
    renamable $edx = XOR32rr undef $edx, undef $edx, implicit-def dead $eflags, implicit-def $rdx
    renamable $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    JMP_1 %bb.7
  
  bb.1:
    renamable $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    RET64 $eax
  
  bb.4 (%ir-block.7):
    successors: %bb.5(0x80000000)
    liveins: $rcx, $rdi
  
    $edx = MOV32rr $ecx, implicit-def $rdx
    renamable $edx = AND32ri renamable $edx, 2147483640, implicit-def dead $eflags, implicit killed $rdx, implicit-def $rdx
    $eax = MOV32rr $ecx, implicit-def $rax
    renamable $eax = SHR32ri renamable $eax, 3, implicit-def dead $eflags, implicit killed $rax, implicit-def $rax
    renamable $eax = AND32ri renamable $eax, 268435455, implicit-def dead $eflags, implicit killed $rax, implicit-def $rax
    renamable $rax = SHL64ri killed renamable $rax, 5, implicit-def dead $eflags
    renamable $xmm0 = PXORrr undef $xmm0, undef $xmm0
    renamable $esi = XOR32rr undef $esi, undef $esi, implicit-def dead $eflags, implicit-def $rsi
    renamable $xmm1 = PXORrr undef $xmm1, undef $xmm1
  
  bb.5 (%ir-block.13, align 16):
    successors: %bb.6(0x04000000), %bb.5(0x7c000000)
    liveins: $rax, $rcx, $rdi, $rdx, $rsi, $xmm0, $xmm1
  
    $xmm2 = MOVDQArr killed $xmm0
    renamable $xmm0 = MOVDQUrm renamable $rdi, 1, renamable $rsi, 0, $noreg :: (load (s128) from %ir.sunkaddr, align 4, !tbaa !5)
    $xmm3 = MOVDQArr killed $xmm1
    renamable $xmm1 = MOVDQUrm renamable $rdi, 1, renamable $rsi, 16, $noreg :: (load (s128) from %ir.sunkaddr7, align 4, !tbaa !5)
    renamable $xmm2 = PADDDrr killed renamable $xmm2, renamable $xmm0
    renamable $xmm0 = PADDDrr killed renamable $xmm0, killed renamable $xmm0
    renamable $xmm0 = PADDDrr killed renamable $xmm0, killed renamable $xmm2
    renamable $xmm3 = PADDDrr killed renamable $xmm3, renamable $xmm1
    renamable $xmm1 = PADDDrr killed renamable $xmm1, killed renamable $xmm1
    renamable $xmm1 = PADDDrr killed renamable $xmm1, killed renamable $xmm3
    renamable $rsi = nuw nsw ADD64ri32 killed renamable $rsi, 32, implicit-def dead $eflags
    CMP64rr renamable $rax, renamable $rsi, implicit-def $eflags
    JCC_1 %bb.5, 5, implicit killed $eflags
  
  bb.6 (%ir-block.23):
    successors: %bb.8(0x40000000), %bb.7(0x40000000)
    liveins: $rcx, $rdi, $rdx, $xmm0, $xmm1
  
    renamable $xmm1 = PADDDrr killed renamable $xmm1, killed renamable $xmm0
    renamable $xmm0 = PSHUFDri renamable $xmm1, -18
    renamable $xmm0 = PADDDrr killed renamable $xmm0, killed renamable $xmm1
    renamable $xmm1 = PSHUFDri renamable $xmm0, 85
    renamable $xmm1 = PADDDrr killed renamable $xmm1, killed renamable $xmm0
    renamable $eax = MOVPDI2DIrr killed renamable $xmm1
    CMP32rr renamable $edx, renamable $ecx, implicit-def $eflags
    JCC_1 %bb.8, 4, implicit $eflags
  
  bb.7 (%ir-block.32, align 16):
    successors: %bb.8(0x04000000), %bb.7(0x7c000000)
    liveins: $eax, $rcx, $rdi, $rdx
  
    renamable $esi = MOV32rm renamable $rdi, 4, renamable $rdx, 0, $noreg, implicit-def $rsi :: (load (s32) from %ir.scevgep, !tbaa !5)
    renamable $esi = LEA64_32r killed renamable $rsi, 2, renamable $rsi, 0, $noreg
    renamable $eax = nsw ADD32rr killed renamable $eax, killed renamable $esi, implicit-def dead $eflags
    renamable $rdx = nuw nsw INC64r killed renamable $rdx, implicit-def dead $eflags
    CMP64rr renamable $rcx, renamable $rdx, implicit-def $eflags
    JCC_1 %bb.7, 5, implicit $eflags
  
  bb.8 (%ir-block.30):
    liveins: $eax
  
    RET64 $eax
...
